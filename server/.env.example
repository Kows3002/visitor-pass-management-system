PORT=5000
NODE_ENV=development
# Local development example. Render must use the exact Atlas driver URI.
MONGODB_URI=mongodb://127.0.0.1:27017/visitor_pass
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Exact frontend origins, comma-separated. Do not include paths or quotes.
CLIENT_URL=http://localhost:5173,https://visitor-pass-management-system-five.vercel.app
APP_TIMEZONE=Asia/Kolkata
# Optional. Used only when the runtime cannot perform Atlas SRV DNS queries.
DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query

# Approval and rejection notifications (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
NOTIFICATION_FROM_EMAIL=Visitor Pass <YOUR_GMAIL_ADDRESS>
NOTIFICATION_REPLY_TO=YOUR_GMAIL_ADDRESS

# Optional approval SMS via Twilio. Visitor phone numbers must use E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
